# ==============================================================================
# BUSINESSOS — VARIABLES D'ENVIRONNEMENT (PHASE 6.2 PRODUCTION HARDENING)
# ==============================================================================
# Copiez ce fichier sous .env.local et renseignez vos identifiants spécifiques.
# RÈGLE DE SÉCURITÉ ABSOLUE :
#   - NE JAMAIS commiter de vraies clés secrètes dans git (.env.local est ignoré).
#   - Les variables sensibles de serveur NE DOIVENT PAS porter le préfixe NEXT_PUBLIC_.

# ──────────────────────────────────────────────────────────────────────────────
# 1. CORE (Supabase, Authentification, Application)
# ──────────────────────────────────────────────────────────────────────────────
# URL publique du projet Supabase
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# Clé publique anonyme Supabase (accessible au navigateur)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clé secrète de service Supabase (STRICTEMENT SERVEUR — JAMAIS EXPOSÉE AU CLIENT)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Paramètres généraux de l'application
NEXT_PUBLIC_APP_URL=https://votre-domaine.com
NEXT_PUBLIC_APP_NAME="BusinessOS"
NEXT_PUBLIC_DEFAULT_CURRENCY="XOF"

# Clés IA (optionnel — assistant commercial)
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...

# ──────────────────────────────────────────────────────────────────────────────
# 2. STRIPE (Paiements CB Internationaux & Abonnements SaaS)
# ──────────────────────────────────────────────────────────────────────────────
# Clé secrète Stripe (sk_test_... en test, sk_live_... en production)
STRIPE_SECRET_KEY=sk_test_51...

# Secret de signature des webhooks Stripe (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_...

# Clé publiable Stripe côté frontend
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51...

# Price IDs des abonnements (optionnels, créés automatiquement si absents)
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_YEARLY=price_...
STRIPE_PRICE_BUSINESS_MONTHLY=price_...
STRIPE_PRICE_BUSINESS_YEARLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...

# ──────────────────────────────────────────────────────────────────────────────
# 3. RESEND (Emails Transactionnels & Factures)
# ──────────────────────────────────────────────────────────────────────────────
# Clé d'API Resend (https://resend.com)
RESEND_API_KEY=re_...

# Adresse d'expédition des devis et factures
RESEND_FROM_EMAIL=facturation@votre-domaine.com

# ──────────────────────────────────────────────────────────────────────────────
# 4. WHATSAPP (WhatsApp Business Cloud API - Meta)
# ──────────────────────────────────────────────────────────────────────────────
# Identifiant du numéro de téléphone WhatsApp Cloud (Graph API)
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# Token d'accès système Meta Cloud API (permanent)
WHATSAPP_ACCESS_TOKEN=EAABsB...

# Jeton de vérification du webhook (configuré dans Meta Developer Console)
WHATSAPP_VERIFY_TOKEN=businessos-webhook-verify-token-production

# ──────────────────────────────────────────────────────────────────────────────
# 5. WAVE (Mobile Money Sénégal, Côte d'Ivoire, Mali)
# ──────────────────────────────────────────────────────────────────────────────
# Clé API Marchand Wave (https://developer.wave.com)
WAVE_API_KEY=wave_sn_prod_...

# ──────────────────────────────────────────────────────────────────────────────
# 6. ORANGE (Orange Money Web Payment)
# ──────────────────────────────────────────────────────────────────────────────
# Identifiants développeur Orange Money (https://developer.orange.com)
ORANGE_MONEY_MERCHANT_KEY=om_merchant_...
ORANGE_MONEY_AUTH_HEADER=Basic ...

# ──────────────────────────────────────────────────────────────────────────────
# 7. MTN (MTN Mobile Money Collections)
# ──────────────────────────────────────────────────────────────────────────────
# Identifiants MoMo API (https://momodeveloper.mtn.com)
MTN_MOMO_SUBSCRIPTION_KEY=momo_sub_...
MTN_MOMO_USER_ID=uuid-user-...
MTN_MOMO_API_KEY=momo_api_key_...

# ──────────────────────────────────────────────────────────────────────────────
# 8. SENTRY (Monitoring & Erreurs Serveur)
# ──────────────────────────────────────────────────────────────────────────────
# DSN Sentry (laisser vide pour désactiver le reporting externe)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ──────────────────────────────────────────────────────────────────────────────
# 9. PDF (Configuration du moteur de génération PDF binaire)
# ──────────────────────────────────────────────────────────────────────────────
# Moteur PDF par défaut : 'pdfkit' (embarqué, sans dépendance binaire externe)
PDF_ENGINE=pdfkit
